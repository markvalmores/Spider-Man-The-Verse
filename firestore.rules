rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidLeaderboard(data, userId) {
      return data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 50 &&
             data.score is number && data.score >= 0 &&
             data.pizzas is number && data.pizzas >= 0 &&
             data.missions is number && data.missions >= 0 &&
             data.heroKarma is number && data.heroKarma >= 0 &&
             data.suit is string && data.suit.size() <= 50 &&
             data.updatedAt is number;
    }

    // Leaderboard collection - readable by all authenticated players or spectators, writable only by the account owner
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidLeaderboard(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    // User account profile - private to the user
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
